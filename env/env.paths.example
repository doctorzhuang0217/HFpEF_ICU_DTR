#!/usr/bin/env bash

export PROJECT_ROOT="/path/to/HFpEF_ICU_DTR"

export RAW_ROOT="$PROJECT_ROOT/data/raw"
export STAGING_ROOT="$PROJECT_ROOT/data/staging"
export INTERIM_ROOT="$PROJECT_ROOT/data/interim"
export PROCESSED_ROOT="$PROJECT_ROOT/data/processed"
export EXTERNAL_ROOT="$PROJECT_ROOT/data/external"

export REPORT_ROOT="$PROJECT_ROOT/reports"
export CONFIG_ROOT="$PROJECT_ROOT/configs"
export MODEL_ROOT="$PROJECT_ROOT/models"
export LOG_ROOT="$PROJECT_ROOT/logs"

# Dataset entrypoints
export MIMIC_ROOT="$RAW_ROOT/mimiciv"
export MIMIC_NOTE_ROOT="$RAW_ROOT/mimiciv/note/2.2/note"
export EICU_ROOT="$RAW_ROOT/eicu/2.0"
export HIRID_ROOT="$RAW_ROOT/hirid/1.1.1"

# Optional future extraction target for HiRID
export HIRID_EXTRACTED_ROOT=""

export PYTHONPATH="$PROJECT_ROOT/src:${PYTHONPATH:-}"